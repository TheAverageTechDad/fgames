{
	"name": "fgames",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"icons": "node scripts/build-icons.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
